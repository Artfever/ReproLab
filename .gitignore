# Never ignore .kiro
.scratch/
runs/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
.env
.env.*
!.env.example
# Never commit upstream binaries, archives or documents
*.tar
*.tar.gz
*.tgz
*.zip
*.so
*.dll
*.exe
*.odc
*.bmp
*.pyc

# Scratch output from local tools
*.log

# Local product (03-local-product)
local-data/
vendor/
# Self-hosted browser libraries (spec 05-ui-redesign) are tracked; the OpenBUGS vendor/ folder is not.
!apps/local/public/vendor/
apps/local/node_modules/
