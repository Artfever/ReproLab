# Copy this file to .env in the repository root. Keep the real keys in .env only.

# Chat assistant: Gemini API over Google's OpenAI-compatible Chat Completions endpoint.
# Get a Gemini API key from Google AI Studio.
CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Optional voice input: recorded audio is sent to Groq for transcription.
# The transcript is added to the question box; it goes to Gemini only if you press Ask.
# Get a Groq API key from the Groq console.
STT_MODEL=whisper-large-v3
GROQ_API_KEY=

# To use another OpenAI-compatible chat endpoint, set CHAT_BASE_URL and use CHAT_MODEL
# plus REPROLAB_LLM_API_KEY. Leave CHAT_BASE_URL unset to use Gemini as above.
# Example local endpoint: CHAT_BASE_URL=http://127.0.0.1:11434/v1
